# Copy this file to .env (gitignored, never commit it) and fill in your own
# foundryvtt.com credentials. Used by docker-compose.yml.

# Choose ONE authentication method:

# Option A: your foundryvtt.com account credentials.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Option B: a presigned temporary release URL instead of username/password --
# generate one from your foundryvtt.com account's "My License" page. If set,
# this takes precedence; leave FOUNDRY_USERNAME/PASSWORD blank.
FOUNDRY_RELEASE_URL=

# Sets the world's admin password on first boot. Pick your own value.
FOUNDRY_ADMIN_KEY=

# Optional overrides -- these already have sensible defaults in docker-compose.yml,
# only set them here if you need something different.
# FOUNDRY_VERSION=14.365
