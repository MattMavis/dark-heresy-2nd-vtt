<div class="dh-wrapper">
    <div class="dh-item">
        <div class="dh-panel dh-grid-col-6">
            <div class="dh-header">
                <div class="dh-header__info">
                    <div class="dh-header__logo dh-header__item-wrapper--span-4">
                        <img class="dh-header__logo-image" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}" data-tooltip="{{item.name}}" />
                    </div>
                    <div class="dh-header__item-wrapper--span-4">
                        <span class="dh-header__title">Name</span>
                        <input class="dh-header__input" name="name" type="text" value="{{item.name}}" />
                    </div>
                    <div class="dh-header__item-wrapper--span-2">
                        <span class="dh-header__title">Source</span>
                        <input class="dh-header__input" name="system.source" type="text" value="{{item.system.source}}" />
                    </div>
                    <div class="dh-header__item-wrapper">
                        <span class="dh-header__title">Weight</span>
                        <input class="dh-header__input" name="system.weight" type="number" data-dtype="Number"
                               value="{{item.system.weight}}" />
                    </div>
                    <div class="dh-header__item-wrapper">
                        <span class="dh-header__title">Quantity</span>
                        <input class="dh-header__input" name="system.quantity" type="number" data-dtype="Number"
                               min="0" step="1" value="{{item.system.quantity}}" />
                    </div>
                    {{#unless item.isUsable}}
                        <div class="dh-header__item-wrapper">
                            <span class="dh-header__title">Equipped</span>
                            <input name="system.equipped" type="checkbox" data-dtype="Boolean" {{checked
                                item.system.equipped}}/>
                        </div>
                    {{/unless}}
                    {{#if item.isUsable}}
                        <div class="dh-header__item-wrapper">
                            <span class="dh-header__title">Duration</span>
                            <input class="dh-header__input" name="system.onUse.durationFormula" type="text"
                                   placeholder="e.g. 3d10" value="{{item.system.onUse.durationFormula}}" />
                        </div>
                        <div class="dh-header__item-wrapper">
                            <span class="dh-header__title">Duration Unit</span>
                            <select class="dh-header__select" name="system.onUse.durationUnit">
                                {{selectOptions (arrayToObject dh.items.duration_units) selected=item.system.onUse.durationUnit}}
                            </select>
                        </div>
                    {{/if}}
                    <div class="dh-header__item-wrapper">
                        <span class="dh-header__title">In Backpack</span>
                        <input name="system.backpack.inBackpack" type="checkbox" data-dtype="Boolean" {{checked
                            item.system.backpack.inBackpack}}/>
                    </div>
                    <div class="dh-header__item-wrapper--span-2">
                        <span class="dh-header__title">Availability</span>
                        <select class="dh-header__select" name="system.availability">
                            {{selectOptions (arrayToObject dh.items.availability) selected=item.system.availability}}
                        </select>
                    </div>
                    <div class="dh-header__item-wrapper--span-2">
                        <span class="dh-header__title">Craftsmanship</span>
                        <select class="dh-header__select" name="system.craftsmanship">
                            {{selectOptions (arrayToObject dh.items.craftsmanship) selected=item.system.craftsmanship}}
                        </select>
                    </div>
                    <div class="dh-header__item-wrapper--text-area">
                        <span class="dh-header__title">Description</span>
                        <textarea class="dh-header__textarea" name="system.description">{{item.system.description}}</textarea>
                    </div>
                </div>
            </div>
        </div>
        {{> systems/dark-heresy-2nd/templates/item/panel/active-effects-panel.hbs}}
    </div>
</div>
