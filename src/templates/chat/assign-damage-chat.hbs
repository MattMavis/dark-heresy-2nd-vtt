<div class="dh-wrapper">
    <div class="dh-chat">
        <div class="dh-roll">
            <h1>{{this.actor.name}}</h1>
            {{#if hasDamage}}<h2>{{this.hit.location}} Hit</h2>{{/if}}
            <div class="dh-roll__divider"></div>

            <div class="dh-roll__row dh-roll__row--number">
                <div class="dh-roll__label">Wounds</div>
                <div class="dh-roll__value">{{this.actor.system.wounds.value}} / {{this.actor.system.wounds.max}}</div>
            </div>
            <div class="dh-roll__row dh-roll__row--number">
                <div class="dh-roll__label">Fatigue</div>
                <div class="dh-roll__value">{{this.actor.system.fatigue.value}} / {{this.actor.system.fatigue.max}}</div>
            </div>
            <div class="dh-roll__row dh-roll__row--number">
                <div class="dh-roll__label">Critical Wounds</div>
                <div class="dh-roll__value">{{this.actor.system.wounds.critical}}</div>
            </div>

            {{#if this.hasDamage}}
                <div class="dh-roll__fail">
                    <span>{{this.damageTaken}}</span>
                    <span>{{this.hit.damageType}} Damage</span>
                </div>
            {{/if}}
            {{#if this.hasFatigueDamage}}
                <div class="dh-roll__fail">
                    <span>{{this.fatigueTaken}}</span>
                    <span>Fatigue</span>
                </div>
            {{/if}}
            {{#if this.hasCriticalDamage}}
                <div class="dh-roll__fail">
                    <span>{{this.criticalDamageTaken}}</span>
                    <span>Critical Damage</span>
                </div>
                <div class="dh-roll__label">{{{this.criticalEffect.text}}}</div>
                {{#with this.resolvedCriticalEffect}}
                    <div class='dh-roll__controls-1'>
                        <div class="dh-control-button roll-control__apply-critical-effect"
                             data-uuid="{{@root.actor.uuid}}"
                             data-damage-type="{{@root.hit.damageType}}"
                             data-location="{{@root.hit.location}}"
                             data-amount="{{@root.criticalAmount}}"
                             data-fatigue="{{this.fatigue}}"
                             data-stunned-rounds="{{this.stunnedRounds}}"
                             data-prone="{{this.prone}}"
                             data-blinded-rounds="{{this.blindedRounds}}"
                             data-blinded-hours="{{this.blindedHours}}"
                             data-blinded-permanent="{{this.blindedPermanent}}"
                             data-blinded-medical="{{this.blindedMedical}}"
                             data-deafened-rounds="{{this.deafenedRounds}}"
                             data-deafened-hours="{{this.deafenedHours}}"
                             data-deafened-permanent="{{this.deafenedPermanent}}"
                             data-deafened-medical="{{this.deafenedMedical}}"
                             data-blood-loss="{{this.bloodLoss}}"
                             data-on-fire="{{this.onFire}}"
                             data-death="{{this.death}}">
                            <span class="dh-control-button__span material-icons">warning</span>
                            <span class="dh-control-button__label">Apply Critical Effect</span>
                        </div>
                    </div>
                {{/with}}
            {{/if}}
        </div>
    </div>
</div>
