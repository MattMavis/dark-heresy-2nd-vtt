{{dhlog this}}
<div class="dh-prompt">
    <div class="dh-wrapper">
        <div class="dh-attack">
            <!-- Header -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-header">
                    <div class="dh-header__prompt dh-header__logo">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <img class="dh-header__logo-image-small" alt="{{this.actor.name}}" src="{{this.actor.img}}" />
                            <span class="dh-header__title">Spend Experience</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Available XP</span>
                    <span class="dh-field__span">{{available}}</span>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Buying is immediate, one step at a time. There is no shopping cart -- each Buy spends XP right away.</span>
                </div>
            </div>

            <!-- Characteristics -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-table--border dh-advancementtable--border">
                    <div class="table-row--head">
                        <div class="table-cell--span2">Characteristic</div>
                        <div class="table-cell">Rank</div>
                        <div class="table-cell">Aptitudes</div>
                        <div class="table-cell">Next Step</div>
                        <div class="table-cell">Cost</div>
                        <div class="table-cell--last">Buy</div>
                    </div>
                    {{#each characteristicRows}}
                        <div class="table-row {{#unless this.nextCost}}is-maxed{{else}}{{#unless this.canAfford}}is-unaffordable{{/unless}}{{/unless}}">
                            <div class="table-cell--span2">{{this.label}}</div>
                            <div class="table-cell">{{this.rankLabel}}</div>
                            <div class="table-cell">{{this.matches}}</div>
                            <div class="table-cell">{{defaultVal this.nextLabel 'Max'}}</div>
                            <div class="table-cell {{#if this.nextCost}}{{#unless this.canAfford}}cost--short{{/unless}}{{/if}}">{{defaultVal this.nextCost '--'}}</div>
                            <div class="table-cell--last">
                                <button
                                    type="button"
                                    class="dh-prompt__button"
                                    data-action="buyCharacteristic"
                                    data-key="{{this.key}}"
                                    {{#unless this.canAfford}}disabled{{/unless}}
                                >Buy</button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>

            <!-- Skills -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-table--border dh-advancementtable--border">
                    <div class="table-row--head">
                        <div class="table-cell--span2">Skill</div>
                        <div class="table-cell">Rank</div>
                        <div class="table-cell">Aptitudes</div>
                        <div class="table-cell">Next Step</div>
                        <div class="table-cell">Cost</div>
                        <div class="table-cell--last">Buy</div>
                    </div>
                    {{#each skillRows}}
                        <div class="table-row {{#unless this.nextCost}}is-maxed{{else}}{{#unless this.canAfford}}is-unaffordable{{/unless}}{{/unless}}">
                            <div class="table-cell--span2">{{this.label}}</div>
                            <div class="table-cell">{{this.rankLabel}}</div>
                            <div class="table-cell">{{this.matches}}</div>
                            <div class="table-cell">{{defaultVal this.nextLabel 'Max'}}</div>
                            <div class="table-cell {{#if this.nextCost}}{{#unless this.canAfford}}cost--short{{/unless}}{{/if}}">{{defaultVal this.nextCost '--'}}</div>
                            <div class="table-cell--last">
                                <button
                                    type="button"
                                    class="dh-prompt__button"
                                    data-action="buySkill"
                                    data-key="{{this.key}}"
                                    data-sp-key="{{this.spKey}}"
                                    {{#unless this.canAfford}}disabled{{/unless}}
                                >Buy</button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>

            <!-- Talents -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-header">
                    <div class="dh-header__info">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <span class="dh-header__subtitle">Talents</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Search</span>
                    <input class="dh-field__input" type="search" name="search" value="{{search}}" />
                </div>
                {{#if isGM}}
                    <div class="dh-field__wrapper">
                        <label class="dh-field__span">
                            <input type="checkbox" data-dtype="Boolean" name="ignorePrerequisites" {{checked ignorePrerequisites}} />
                            GM: ignore talent prerequisites
                        </label>
                    </div>
                {{/if}}
                <div class="dh-table--border dh-advancementtable--border">
                    <div class="table-row--head">
                        <div class="table-cell--span2">Name</div>
                        <div class="table-cell">Tier</div>
                        <div class="table-cell">Prerequisites</div>
                        <div class="table-cell">Matches</div>
                        <div class="table-cell">Cost</div>
                        <div class="table-cell--last">Buy</div>
                    </div>
                    {{#each visibleTalents}}
                        <div class="table-row {{#unless this.canAfford}}is-unaffordable{{/unless}} {{#if this.prereqBlocked}}is-prereq-unmet{{/if}}">
                            <div class="table-cell--span2 cell-inline">
                                <img class="dh-field__image" alt="{{this.name}}" src="{{this.img}}" />
                                <div class="display">{{this.name}}</div>
                            </div>
                            <div class="table-cell">{{this.tier}}</div>
                            <div class="table-cell prereq-list">
                                {{#each this.prereqClauses}}
                                    <div class="prereq-clause prereq-clause--{{this.status}}">{{this.text}}</div>
                                {{else}}
                                    <span class="prereq-none">--</span>
                                {{/each}}
                            </div>
                            <div class="table-cell">{{this.matches}}</div>
                            <div class="table-cell {{#unless this.canAfford}}cost--short{{/unless}}">{{this.cost}}</div>
                            <div class="table-cell--last">
                                <button
                                    type="button"
                                    class="dh-prompt__button"
                                    data-action="buyTalent"
                                    data-pack="{{this.pack}}"
                                    data-item-id="{{this.itemId}}"
                                    {{#unless this.canAfford}}disabled{{/unless}}
                                >Buy</button>
                            </div>
                        </div>
                    {{else}}
                        <div class="table-row">
                            <div class="table-cell">No talents match the current filter, or the tier is not 1-3.</div>
                        </div>
                    {{/each}}
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Psychic powers are not priced from this window -- their cost is not aptitude-table driven.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Buttons -->
    <footer class="form-footer">
        <button type="button" class="dh-prompt__button" data-action="cancel" id="advancement-close">
            <i class="dh-material">close</i>
            <span>Close</span>
        </button>
    </footer>
</div>
