{{dhlog this}}
<div class="dh-prompt">
    <div class="dh-wrapper">
        <div class="dh-attack">
            <!-- Header -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-header">
                    <div class="dh-header__prompt dh-header__logo">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <img class="dh-header__logo-image-small" alt="{{this.actor.name}}" src="{{this.actor.img}}" />
                            <span class="dh-header__title">Spend Experience</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Available XP</span>
                    <span class="dh-field__span">{{available}}</span>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Buying is immediate, one step at a time. There is no shopping cart -- each Buy spends XP right away.</span>
                </div>
            </div>

            <!-- Characteristics -->
            <div class="dh-panel dh-grid-col-full">
                {{> "systems/dark-heresy-2nd/templates/prompt/partial/advance-table.hbs"
                    rows=characteristicRows heading="Characteristic" action="buyCharacteristic"}}
            </div>

            <!-- Skills -->
            <div class="dh-panel dh-grid-col-full">
                {{> "systems/dark-heresy-2nd/templates/prompt/partial/advance-table.hbs"
                    rows=skillRows heading="Skill" action="buySkill"}}
            </div>

            <!-- Talents -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-header">
                    <div class="dh-header__info">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <span class="dh-header__subtitle">Talents</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Search</span>
                    <input class="dh-field__input" type="search" name="search" value="{{search}}" />
                </div>
                {{#if isGM}}
                    <div class="dh-field__wrapper">
                        <label class="dh-field__span">
                            <input type="checkbox" data-dtype="Boolean" name="ignorePrerequisites" {{checked ignorePrerequisites}} />
                            GM: ignore talent/psychic power prerequisites
                        </label>
                    </div>
                {{/if}}
                {{> "systems/dark-heresy-2nd/templates/prompt/partial/talent-table.hbs" rows=visibleTalents}}
            </div>

            {{!-- Psychic Powers -- only psykers can learn them, so the section is hidden entirely
                  for non-psykers rather than offering them 114 powers they cannot take. --}}
            {{#if isPsyker}}
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-header">
                    <div class="dh-header__info">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <span class="dh-header__subtitle">Psychic Powers</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Search</span>
                    <input class="dh-field__input" type="search" name="powerSearch" value="{{powerSearch}}" />
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Discipline</span>
                    <select class="dh-field__input" name="disciplineFilter">
                        <option value="" {{#unless disciplineFilter}}selected{{/unless}}>All</option>
                        {{#each disciplines}}
                            <option value="{{this}}" {{#if (eq this ../disciplineFilter)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                {{> "systems/dark-heresy-2nd/templates/prompt/partial/psychic-power-table.hbs" rows=visiblePsychicPowers}}
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Buttons -->
    <footer class="form-footer">
        <button type="button" class="dh-prompt__button" data-action="cancel" id="advancement-close">
            <i class="dh-material">close</i>
            <span>Close</span>
        </button>
    </footer>
</div>
