{{dhlog this}}
<div class="dh-prompt">
    <div class="dh-wrapper">
        <div class="dh-attack">
            <!-- Header -->
            <div class="dh-panel dh-grid-col-half">
                <div class="dh-header">
                    <div class="dh-header__prompt dh-header__logo">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <img class="dh-header__logo-image-small" alt="{{this.sourceActor.name}}" src="{{this.sourceActor.img}}" />
                            <span class="dh-header__title">Requisition</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Base (Inf)</span>
                    <span class="dh-field__span">{{baseTarget}}</span>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Combined Modifier</span>
                    <span class="dh-field__span">{{modifierTotal}}</span>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Target</span>
                    <span class="dh-field__span">{{modifiedTarget}}</span>
                </div>
                {{#if warbandActor}}
                    <div class="dh-field__wrapper">
                        <span class="dh-field__span">Warband Subtlety</span>
                        <span class="dh-field__span">{{warbandActor.subtlety.value}} / {{warbandActor.subtlety.max}}</span>
                    </div>
                {{else}}
                    <div class="dh-field__wrapper">
                        <span class="dh-field__span">Warband Subtlety</span>
                        <span class="dh-field__span">No Warband Tracker found</span>
                    </div>
                {{/if}}
            </div>

            <!-- Filters -->
            <div class="dh-panel dh-grid-col-half">
                <div class="dh-header">
                    <div class="dh-header__info">
                        <div class="dh-header__item-wrapper--span-4 dh-header__borderless">
                            <span class="dh-header__subtitle">Filter</span>
                        </div>
                    </div>
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Search</span>
                    <input class="dh-field__input" type="search" name="search" value="{{search}}" />
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">Max Availability</span>
                    <select class="dh-field__input" name="availabilityFilter">
                        {{selectOptions availabilityOptions selected=availabilityFilter}}
                    </select>
                </div>
            </div>

            <!-- Candidate list -->
            <div class="dh-panel dh-grid-col-full">
                <div class="dh-table--border dh-attackprompttable--border">
                    <div class="table-row--head">
                        <div class="table-cell"></div>
                        <div class="table-cell">Name</div>
                        <div class="table-cell">Availability</div>
                        <div class="table-cell">Craftsmanship</div>
                        <div class="table-cell">Modifier</div>
                        <div class="table-cell--last">Qty</div>
                    </div>
                    {{#each visibleCandidates}}
                        <div class="table-row">
                            <div class="table-cell--left">
                                <input
                                    class="table-cell--checkbox requisition-select"
                                    type="checkbox"
                                    data-dtype="Boolean"
                                    data-pack="{{this.pack}}"
                                    data-item-id="{{this.itemId}}"
                                    {{checked this.selected}}
                                />
                            </div>
                            <div class="table-cell">
                                <img class="dh-field__image" alt="{{this.name}}" src="{{this.img}}" />
                                <div class="display">{{this.name}}</div>
                            </div>
                            <div class="table-cell">{{this.availability}}</div>
                            <div class="table-cell">{{this.craftsmanship}}</div>
                            <div class="table-cell">{{this.modifier}}</div>
                            <div class="table-cell--last">
                                <input
                                    class="dh-field__input requisition-quantity"
                                    type="number"
                                    min="1"
                                    data-dtype="Number"
                                    data-pack="{{this.pack}}"
                                    data-item-id="{{this.itemId}}"
                                    value="{{this.quantity}}"
                                />
                            </div>
                        </div>
                    {{else}}
                        <div class="table-row">
                            <div class="table-cell">No items match the current filter.</div>
                        </div>
                    {{/each}}
                </div>
                <div class="dh-field__wrapper">
                    <span class="dh-field__span">v1: grants exactly the quantity selected, no automatic bonus-on-degrees-of-success.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Buttons -->
    <footer class="form-footer">
        <button type="button" class="dh-prompt__button" data-action="roll" id="requisition-roll">
            <i class="dh-material">casino</i>
            <span>Roll Requisition Test</span>
        </button>
        <button type="button" class="dh-prompt__button" data-action="cancel" id="requisition-cancel">
            <i class="dh-material">close</i>
            <span>Cancel</span>
        </button>
    </footer>
</div>
