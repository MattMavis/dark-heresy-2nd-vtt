{{dhlog this}}
<div class="dh-wrapper">
    <div class="dh-actor">
        <div class="dh-header dh-grid-col-6 dh-panel">
            <div class="dh-header__info">
                <div class="dh-header__logo dh-header__item-wrapper--span-4">
                    <img class="dh-header__logo-image" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" data-tooltip="{{actor.name}}" />
                </div>
                <div class="dh-header__item-wrapper--span-2">
                    <span class="dh-header__title">Name</span>
                    <input class="dh-header__input" name="name" type="text" value="{{actor.name}}" />
                </div>
                {{#each actor.bio}}
                    {{#if (arrayIncludes @key @root.dh.bio.primary)}}
                        {{> systems/dark-heresy-2nd/templates/actor/partial/character-field.hbs key=@key value=this options=(getBioOptions @key)}}
                    {{/if}}
                {{/each}}
            </div>
        </div>

        <div class="dh-navigation tabs" data-group="primary">
            <label class="dh-navigation__item dh-navigation__item-left">
                <a class="item {{tabs.combat.cssClass}}" data-action="tab" data-tab="combat" data-group="primary">combat</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.main.cssClass}}" data-action="tab" data-tab="main" data-group="primary">main</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.bio.cssClass}}" data-action="tab" data-tab="bio" data-group="primary">bio</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.gear.cssClass}}" data-action="tab" data-tab="gear" data-group="primary">gear</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.psychic.cssClass}}" data-action="tab" data-tab="psychic" data-group="primary">psychic powers</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.advances.cssClass}}" data-action="tab" data-tab="advances" data-group="primary">advances</a>
            </label>
            <label class="dh-navigation__item">
                <a class="item {{tabs.social.cssClass}}" data-action="tab" data-tab="social" data-group="primary">social</a>
            </label>
        </div>

        <section class="dh-body">
            <div class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
                {{> systems/dark-heresy-2nd/templates/actor/panel/wounds-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/fatigue-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/fate-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/armour-display-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/combat-controls-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/initiative-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/characteristic-roller-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/movement-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/active-effects-panel.hbs}}

            </div>
            <div class="tab {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
                {{> systems/dark-heresy-2nd/templates/actor/panel/characteristic-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/trait-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/bonuses-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/skills-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/skills-specialist-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/talent-panel.hbs}}
            </div>
            <div class="tab {{tabs.bio.cssClass}}" data-group="primary" data-tab="bio">
                <div class="dh-panel dh-grid-col-6">
                    <div class="dh-header__info">
                        <h1 class="dh-panel__header dh-grid-col-4">Biography</h1>
                        <div class="dh-controls__wrapper">
                            <div class="dh-control-button">
                                <button type="button" class="combat-control" data-action="characterCreation">Character Creation</button>
                            </div>
                        </div>
                        {{#each actor.bio}}
                            {{#unless (arrayIncludes @key @root.dh.bio.primary)}}
                                {{> systems/dark-heresy-2nd/templates/actor/partial/character-field.hbs key=@key value=this options=(getBioOptions @key)}}
                            {{/unless}}
                        {{/each}}
                    </div>
                </div>
            </div>
            <div class="tab {{tabs.gear.cssClass}}" data-group="primary" data-tab="gear">
                {{> systems/dark-heresy-2nd/templates/actor/panel/weapon-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/encumbrance-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/armour-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/storage-location-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/cybernetic-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/backpack-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/force-field-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/gear-panel.hbs}}
            </div>
            <div class="tab {{tabs.psychic.cssClass}}" data-group="primary" data-tab="psychic">
                {{> systems/dark-heresy-2nd/templates/actor/panel/psychic-powers-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/psy-panel.hbs}}
            </div>
            <div class="tab {{tabs.advances.cssClass}}" data-group="primary" data-tab="advances">
                {{> systems/dark-heresy-2nd/templates/actor/panel/corruption-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/aptitude-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/insanity-panel.hbs}}
                {{! Last and full width: its three tables need the room, and following the three
                    2-column panels means it starts a fresh row rather than leaving a gap. }}
                {{> systems/dark-heresy-2nd/templates/actor/panel/experience-panel.hbs}}
            </div>
            <div class="tab {{tabs.social.cssClass}}" data-group="primary" data-tab="social">
                {{> systems/dark-heresy-2nd/templates/actor/panel/journal-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/peer-panel.hbs}}
                {{> systems/dark-heresy-2nd/templates/actor/panel/enemy-panel.hbs}}
            </div>
        </section>
    </div>
</div>


